{
  "name": "radon-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "data:build-search-base": "node scripts/build-search-base.mjs",
    "data:validate": "node scripts/validate-search-base.mjs",
    "infra:deploy:preview": "npm --prefix infrastructure run cdk -- deploy RadonToolPreviewStack --require-approval never",
    "infra:deploy:prod": "npm --prefix infrastructure run cdk -- deploy RadonToolProdStack --require-approval never",
    "deploy:preview": "node scripts/deploy-site.mjs --env preview --cdk-deploy",
    "deploy:prod": "node scripts/deploy-site.mjs --env prod --cdk-deploy"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
